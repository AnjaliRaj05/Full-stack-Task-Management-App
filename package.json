{
  "name": "taskora",
  "version": "1.0.0",
  "private": true,
  "description": "Taskora — full-stack task management platform with workspaces, Kanban, and subtasks",
  "scripts": {
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "lint": "cd backend && npm run lint && cd ../frontend && npm run lint",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnjaliRaj05/Full-stack-Task-Management-App.git"
  },
  "license": "ISC",
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3"
  },
  "lint-staged": {
    "backend/**/*.js": [
      "prettier --write"
    ],
    "frontend/**/*.{js,jsx}": [
      "prettier --write"
    ]
  }
}
